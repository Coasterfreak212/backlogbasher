# BacklogBasher — Self-Hosted Home Gaming ERP Configuration
# Copy this file to .env or pass these variables via Docker / systemd

# HTTP server listening port
PORT=8080

# Path to local SQLite database file (auto-created and seeded on first boot)
DB_PATH=./data/consoleerp.db

# Local directory where uploaded custom rig/handheld photos are stored
UPLOAD_DIR=./data/uploads
